{{- /*
  Generated from .chezmoidata/configs.yaml: the configs this machine does not get. A pattern only matches its own
  level, so each path is listed with /** as well, which also covers externals inside it (the antidote clone).
*/ -}}
{{- $host := get .hostConfigs .chezmoi.hostname | default dict -}}
{{- $add := get $host "add" | default list -}}
{{- $drop := get $host "drop" | default list -}}
{{- range $name, $config := .configs }}
{{-   $wanted := has $.role $config.roles -}}
{{-   if and (hasKey $config "os") (ne $config.os $.chezmoi.os) }}{{ $wanted = false }}{{ end -}}
{{-   if has $name $add }}{{ $wanted = true }}{{ end -}}
{{-   if has $name $drop }}{{ $wanted = false }}{{ end -}}
{{-   if not $wanted }}
# {{ $name }}
{{-     range $config.paths }}
{{ . }}
{{ . }}/**
{{-     end }}
{{-   end }}
{{- end }}
