{{ if and (eq .chezmoi.os "darwin") (eq .role "workstation") -}}
#!/bin/bash
# Runs again whenever the rendered Brewfile changes: {{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . | sha256sum }}
set -euo pipefail
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $brew ]] && eval "$("$brew" shellenv)" && break
done
brew bundle install --file="$HOME/.config/homebrew/Brewfile"
{{ end -}}
