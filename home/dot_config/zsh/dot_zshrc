_comp_options+=(globdots)

fpath+=($ZDOTDIR/functions) # ~/.config/zsh, or ~/.config/skylar-zsh on a shared (guest) account
cdpath=(~/projects)

export ZVM_SYSTEM_CLIPBOARD_ENABLED=true
# Only inside Ghostty: over ssh the other machine usually has no terminfo entry for it
[[ -n $GHOSTTY_RESOURCES_DIR ]] && export TERM=xterm-ghostty

# History: one file per ZDOTDIR (the guest shell keeps its own), shared live between open shells
HISTFILE=$ZDOTDIR/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt extended_history     # save when each command ran and how long it took
setopt share_history        # every shell writes each command at once and sees the others'
setopt hist_ignore_all_dups # running a command again drops its older copy
setopt hist_ignore_space    # a command typed with a leading space is not saved
setopt hist_reduce_blanks
setopt hist_verify          # !! and friends expand into the line for review instead of running

hash -d p=~/projects
setopt auto_cd auto_pushd pushd_ignore_dups

autoload -Uz sshp projects copyfile y
sshp-widget() { zle push-input; BUFFER=sshp; zle accept-line }
pj-widget() { zle push-input; BUFFER=projects; zle accept-line; zle reset-prompt }
copyfile-widget() { zle push-input; BUFFER=copyfile; zle accept-line; zle reset-prompt }
yazi-widget() { zle push-input; BUFFER=y; zle accept-line; zle reset-prompt }

zle -N sshp-widget
zle -N pj-widget
zle -N copyfile-widget
zle -N yazi-widget

# fzf: TokyoNight Moon colours (tokyonight.nvim's extras/fzf), previews for Ctrl-T (files) and Alt-C (directories)
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border=rounded --info=inline-right --highlight-line --ansi \
  --color=bg+:#2d3f76,bg:#1e2030,border:#589ed7,fg:#c8d3f5,gutter:#1e2030,header:#ff966c,hl+:#65bcff,hl:#65bcff \
  --color=info:#545c7e,marker:#ff007c,pointer:#ff007c,prompt:#65bcff,query:#c8d3f5:regular,scrollbar:#589ed7 \
  --color=separator:#ff966c,spinner:#ff007c"
if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi
if (( $+commands[bat] )); then
    export BAT_THEME=ansi # bat uses the terminal's colours
    export MANPAGER="sh -c 'col -bx | bat --language=man --plain'" # man pages with highlighting
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:300 {}'"
else
    export FZF_CTRL_T_OPTS="--preview 'head -n 300 {}'"
fi
if (( $+commands[eza] )); then
    export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always --icons=always {}'"
    # Tab completion of cd (fzf-tab) previews the directory too
    zstyle ':fzf-tab:complete:(cd|z|__zoxide_z):*' fzf-preview 'eza -1 --color=always --icons=always $realpath'
fi
zstyle ':fzf-tab:*' use-fzf-default-opts yes # fzf-tab menus get the colours above

# eza: ls with colours, git status and icons. Plain `ls` stays the system one.
if (( $+commands[eza] )); then
    alias ll='eza -l --git --group-directories-first --icons=auto'
    alias la='eza -la --git --group-directories-first --icons=auto'
    alias lt='eza --tree --level=2 --group-directories-first --icons=auto'
fi

function zvm_after_init() {
    (( $+commands[fzf] )) && source <(fzf --zsh)
    zvm_bindkey vicmd 'gs' sshp-widget    # normal mode: "go ssh"
    zvm_bindkey vicmd 'gp' pj-widget
    zvm_bindkey vicmd 'gy' copyfile-widget    # "go yank": pick a file, copy its contents
    zvm_bindkey vicmd 'gf' yazi-widget        # "go files": yazi, then cd to where you quit
}


source ${ZDOTDIR:-$HOME}/.antidote/antidote.zsh
antidote load
compdef _files copyfile   # copyfile <Tab> completes file names
compdef _files y

# Prompt (~/.config/starship.toml); without starship, a plain one with the directory and exit status
if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
else
    PROMPT='%F{blue}%~%f %(?.%F{green}.%F{red})❯%f '
fi

# zoxide, last as its docs ask: `z proj` jumps to the most used directory matching "proj", `zi` picks with fzf
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
