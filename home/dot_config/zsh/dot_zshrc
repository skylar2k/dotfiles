# Interactive zsh: every file in conf.d/ in name order. Each file covers one topic, and a file for an optional tool
# returns early when the tool is not installed. Order matters in a few places, which the numbers keep:
# zsh-vi-mode settings and hooks (10-50) come before the plugins load (60); the prompt and zoxide come last.
for _conf in $ZDOTDIR/conf.d/*.zsh(N); do
    source $_conf
done
unset _conf
