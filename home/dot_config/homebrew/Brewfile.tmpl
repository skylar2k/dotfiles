tap "felixkratz/formulae"
# Checks ansible playbooks for practices and behaviour
brew "ansible-lint"
brew "bitwise"
# Language server for NASM/GAS/GO Assembly
brew "asm-lsp"
# Secure and free password manager for all of your devices
# cat with syntax highlighting (fzf previews, man pages)
brew "bat"
brew "bitwarden-cli"
# Manages these dotfiles
brew "chezmoi"
# Window border system for macOS (config: ~/.config/borders/bordersrc)
brew "felixkratz/formulae/borders"
# GNU File, Shell, and Text utilities
brew "coreutils"
# Simple, fast and user-friendly alternative to find
# ls with colours, git status and icons
brew "eza"
brew "fd"
# Command-line fuzzy finder written in Go
brew "fzf"
# Distributed revision control system
brew "git"
# Open-source GitLab command-line tool
brew "glab"
# Tools and libraries to manipulate images in many formats (snacks.nvim converts images with it)
brew "imagemagick"
# Simple terminal UI for git commands
brew "lazygit"
# Powerful, lightweight programming language
brew "lua"
# Language Server for the Lua language
brew "lua-language-server"
# Package manager for the Lua programming language
brew "luarocks"
brew "zig"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# OpenBSD freely-licensed SSH connectivity tools
brew "openssh"
# Drop-in replacement for Terraform. Infrastructure as Code Tool
brew "opentofu"
# Paste PNG into files, much like pbpaste does for text (for :Obsidian paste_img)
brew "pngpaste"
# Code formatter for JavaScript, CSS, JSON, GraphQL, Markdown, YAML and more
brew "prettier"
# Fast type checker and IDE for Python
brew "pyrefly"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Extremely fast Python linter, written in Rust
brew "ruff"
# Organize software neatly under a single directory tree (e.g. /usr/local)
# Opinionated Lua code formatter
# The shell prompt (~/.config/starship.toml)
brew "starship"
brew "stylua"
# Parser generator tool
brew "tree-sitter-cli"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"
# Language server for YAML files
brew "yaml-language-server"
# Tool for managing your YubiKey configuration
brew "ykman"
brew "yazi"
# Language Server for Zig (needs zig, which is listed above)
brew "zls"
# Jump to frequent directories: z <part of the name>
brew "zoxide"
cask "font-symbols-only-nerd-font"
{{ if .work -}}
# Software installation manager
cask "munki"
{{ end -}}

# Deliberately not listed: uv tools installed from local checkouts (graph-macos, pywm, wm-py).
# `brew bundle` would install same-named PyPI packages instead of your projects on a new host.
# Reinstall them by hand: `uv tool install ~/projects/<name>`.
# `brew bundle dump --force` re-adds them and drops this note: review `git diff` after a refresh.
