Host p1kdlogin
    HostName p1kdlogin.uib.no
    User skjoh4753
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 8h
    ServerAliveInterval 30

Host zargal zargal.uib.no xzar xzar.uib.no turg turg.uib.no
    Tag via_p1kdlogin

Host eplebakst3 eplebakst3.uib.no
    User munki

Host itgit itgit.app.uib.no
    HostName itgit.app.uib.no
    User git
    SetEnv TERM=xterm-256color

# Apply jumphost settings to anything tagged (but never the p1kdlogin itself)
Match tagged via_p1kdlogin !host p1kdlogin
    ProxyJump p1kdlogin
    User skjoh
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 1h

Host *
    ServerAliveInterval 60
